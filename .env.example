# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest_secure_password_change_me

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password_change_me

# JWT Secret for Auth
JWT_SECRET=super-secret-jwt-key-change-in-production-minimum-32-characters

# NextAuth Secret
NEXTAUTH_SECRET=super-secret-nextauth-key-change-in-production-minimum-32-characters

# Application Settings
APP_ENV=development
LOG_LEVEL=debug

# External API Keys (если потребуется в будущем)
# OPENAI_API_KEY=your-openai-api-key-here
